{
  "name": "hackers-ai-cli",
  "version": "1.0.0",
  "description": "Claude-Code-style terminal agent UI for the Hackers AI local proxy",
  "type": "module",
  "bin": {
    "hackers-ai": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p . && chmod +x dist/index.js",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.2.0",
    "node-fetch": "^3.3.2",
    "chalk": "^5.3.0",
    "conf": "^12.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
